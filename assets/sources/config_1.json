{
  "search_config": {
    "url": "{host}/api/videos/search?q={q}&page=1&page_size=24",
    "details_format": "{host}anime/{result}",
    "item_regex": "\"video_id\":\\s*(\\d+)[\\s\\S]*?\"title\":\\s*\"((?:[^\"\\\\]|\\\\.)*)\"[\\s\\S]*?\"cover_url\":\\s*\"([^\"]+)\"",
    "fields": {
      "image": {
        "match_index": 3,
        "description": "作品封面图片地址"
      },
      "url": {
        "match_index": 1,
        "description": "详情页作品 ID"
      },
      "title": {
        "match_index": 2,
        "description": "作品标题名称"
      }
    }
  }
}
